{
  "name": "expediente-cfm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "dev": "node node_modules/next/dist/bin/next dev --turbo",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "local": "npm run build && node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3017",
    "lint": "node node_modules/next/dist/bin/next lint",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:test": "node --env-file=.env.local scripts/test-db.mjs",
    "test:perf:db": "node --env-file=.env.local scripts/perf-db.mjs",
    "test:perf:http": "node scripts/perf-http.mjs",
    "test:e2e": "node --env-file=.env.local scripts/e2e.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.0",
    "@radix-ui/react-avatar": "1.1.0",
    "@radix-ui/react-checkbox": "1.1.1",
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-popover": "1.1.1",
    "@radix-ui/react-progress": "1.1.0",
    "@radix-ui/react-select": "2.1.1",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.0",
    "@radix-ui/react-tabs": "1.1.0",
    "@radix-ui/react-toast": "1.2.1",
    "@radix-ui/react-tooltip": "1.1.2",
    "@radix-ui/react-visually-hidden": "1.1.0",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/blob": "^2.8.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.446.0",
    "mammoth": "^1.12.1",
    "next": "14.2.35",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "8.13.1",
    "puppeteer-core": "^25.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.5.2"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4"
  }
}
